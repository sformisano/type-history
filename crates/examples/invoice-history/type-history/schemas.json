  "billing.payment.recorded": {
    "1": {
      "metadata": {},
      "schema": {
        "$id": "urn:typehistory:schema:billing.payment.recorded",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "currency_code": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "Paid": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "Paid"
                ],
                "type": "object"
              },
              {
                "const": "Pending"
              }
            ]
          }
        },
        "required": [
          "currency_code",
          "reference",
          "status"
        ],
        "type": "object"
      }
    },
