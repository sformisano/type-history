        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "Paid": {
                    "additionalProperties": false,
                    "properties": {
                      "amount_minor": {
                        "format": "uint64",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "currency": {
                        "enum": [
                          "Eur",
                          "Usd"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "amount_minor",
                      "currency"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "Paid"
                ],
                "type": "object"
              },
              {
                "const": "Pending"
              }
            ]
          }
        },
        "required": [
          "reference",
          "status"
        ],
        "type": "object"
      }
    }
  },
